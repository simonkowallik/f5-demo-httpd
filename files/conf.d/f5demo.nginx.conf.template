map $scheme $f5demo_scheme {
  http 'HTTP';
  https 'HTTPS';
  default 'UNKNOWN';
}

map $scheme $f5demo_nodename {
  default '${F5DEMO_NODENAME}';
}

map $scheme $f5demo_color {
  http '${F5DEMO_COLOR}';
  https '${F5DEMO_COLOR_SSL}';
  default 'UNKNOWN';
}


js_import conf.d/f5demo.js;


server {
    listen ${F5DEMO_LISTEN_ADDR}:${F5DEMO_LISTEN_PORT} default_server;
    listen ${F5DEMO_LISTEN_ADDR_SSL}:${F5DEMO_LISTEN_PORT_SSL} ssl default_server;
    http2 on;
    server_name _;

		ssl_certificate /etc/nginx/ssl/eccert.pem;
		ssl_certificate_key /etc/nginx/ssl/eckey.pem;
		ssl_certificate /etc/nginx/ssl/cert.pem;
		ssl_certificate_key /etc/nginx/ssl/key.pem;
		ssl_trusted_certificate /etc/nginx/ssl/chain.pem;

    include mime.types;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Powered-By "https://github.com/simonkowallik/f5-demo-httpd" always;

    location /index.html {
        sub_filter_once off;
        #sub_filter_types text/html;
        sub_filter '<!--F5DEMO_COLOR-->' $f5demo_color;
        sub_filter '<!--F5DEMO_NODENAME-->' $f5demo_nodename;
    }

    location /redirect-tests.html {
        sub_filter_once off;
        sub_filter '<!--F5DEMO_COLOR-->' $f5demo_color;
    }

    location /json { js_content f5demo.f5demo_json; }
    location /text { js_content f5demo.f5demo_text; }
    location /ping { js_content f5demo.f5demo_ping; }

    # test-case: ltm profile http <profilename> redirect-rewrite matching
    location /redirect/matching { return 302 http://$host$request_uri/new; }
    
    # test-case: ltm profile http <profilename> redirect-rewrite all
    location /redirect/all { return 302 http://$host/redirect/new-all; }

    # successful rewrites end here:
    location /redirect/matching/new { default_type application/json; return 200 '{"status":"success","path":"$request_uri"}'; }
    location /redirect/new-all { default_type application/json; return 200 '{"status":"success","path":"$request_uri"}'; }

    # advanced test-cases: ltm profile http <profilename> redirect-rewrite not sufficient
    # create ltm profile rewrite new uri-rules replace-all-with { rule1 { client { host external.host.example.com path / scheme https } server { path / } type response } }
    location /redirect/host-matching { return 302 http://internal.host.name$request_uri/new; }

    location /redirect/host-all { return 302 http://internal.host.name/redirect/host-new-all; }
    location /redirect/hostport-all { return 302 http://internal.host.name:54321/redirect/hostport-new-all; }

    # successful advanced rewrites end here:
    location /redirect/host-matching/new { default_type application/json; return 200 '{"status":"success","path":"$request_uri"}'; }

    location /redirect/host-new-all { default_type application/json; return 200 '{"status":"success","path":"$request_uri"}'; }
    location /redirect/hostport-new-all { default_type application/json; return 200 '{"status":"success","path":"$request_uri"}'; }

}
